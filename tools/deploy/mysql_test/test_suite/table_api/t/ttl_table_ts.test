#owner: shenyunlong.syl
#owner group: shenzhen

connect (sys,$OBMYSQL_MS0,admin,$OBMYSQL_PWD,test,$OBMYSQL_PORT);
connection sys;

--disable_query_log

let $zone = query_get_value(select zone from oceanbase.dba_ob_zones, zone, 1);
let $unit_num = query_get_value(select count(*) as c from oceanbase.__all_server group by zone, c, 1);

--disable_warnings
DROP TENANT IF EXISTS tenant_test_ttl FORCE;
DROP RESOURCE POOL IF EXISTS pool_ttl_test;
DROP RESOURCE UNIT IF EXISTS unit_ttl_test;
--enable_warnings

eval CREATE RESOURCE UNIT unit_ttl_test MAX_CPU=1, MEMORY_SIZE='2G';
eval CREATE RESOURCE POOL pool_ttl_test UNIT='unit_ttl_test', UNIT_NUM=$unit_num;
eval CREATE TENANT tenant_test_ttl PRIMARY_ZONE = $zone, REPLICA_NUM = 1, RESOURCE_POOL_LIST = ('pool_ttl_test') set ob_tcp_invited_nodes='%', ob_kv_mode='TABLEAPI';

sleep 3;

let $__tenant_name__ = 'tenant_test_ttl';
--source mysql_test/include/get_tenant_server.inc
connect (conn_test_ttl_root, $TE_SERVER_IP, root@tenant_test_ttl,,test, $TE_SERVER_PORT);
connection conn_test_ttl_root;
--enable_query_log

alter system minor freeze;
alter system set enable_kv_ttl = true;
alter system set ttl_thread_score = 4;

--disable_warnings
drop table if exists ttl_table_ts;
create table ttl_table_ts(a varchar(1024) primary key, b varchar(1024), c timestamp) TTL(c + INTERVAL 0 SECOND) partition by key(a) partitions 7;

# insert 4*7*500 rows, save one rows per cell
--let $count = 0
while($count < 500)
{
  --let $stmt=insert into ttl_table_ts(a, b, c) values (concat('row', cast($count as char)), 'hello world', now());
  
  eval $stmt;
  inc $count;
}
while($count < 600)
{
  --let $stmt=insert into ttl_table_ts(a, b, c) values (concat('row', cast($count as char)), 'hello world', date_add(now(), interval + 2 MINUTE));
  
  eval $stmt;
  inc $count;
}

sleep 3;
alter system trigger ttl;

--disable_query_log
let $__wait_start_us__ = `select time_to_usec(current_timestamp(6)) from dual`;
let $__wait_timeout_us__ = 180000000;
let $__ttl_done__ = 0;
while($__ttl_done__ == 0)
{
  real_sleep 1;
  let $__wait_used_us__ = `select time_to_usec(current_timestamp(6)) - $__wait_start_us__ from dual`;
  if($__wait_used_us__ > $__wait_timeout_us__)
  {
    let $__ttl_done__ = -1;
  }
  if($__ttl_done__ == 0)
  {
    let $__row_cnt__ = query_get_value(select count(*) as c from ttl_table_ts, c, 1);
    let $__history_cnt__ = query_get_value(select count(*) as c from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY where table_name = 'ttl_table_ts' and STATUS = 'FINISHED' and RET_CODE = 'OB_SUCCESS', c, 1);
    let $__global_history_cnt__ = query_get_value(select count(*) as c from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY h where h.table_id = -1 and h.STATUS = 'FINISHED' and h.RET_CODE = 'OB_SUCCESS' and exists (select 1 from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY t where t.table_name = 'ttl_table_ts' and t.task_id = h.task_id), c, 1);
    if($__row_cnt__ == 100)
    {
      if($__history_cnt__ == 7)
      {
        if($__global_history_cnt__ > 0)
        {
          let $__ttl_done__ = 1;
        }
      }
    }
  }
}
if($__ttl_done__ != 1)
{
  --die ttl_table_ts ttl task timeout
}
--enable_query_log
select count(*) from ttl_table_ts;
select TABLE_NAME, TRIGGER_TYPE, STATUS, TTL_DEL_CNT, MAX_VERSION_DEL_CNT, SCAN_CNT, RET_CODE from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY where table_name = 'ttl_table_ts' order by tablet_id;

drop table ttl_table_ts;

--disable_warnings
drop table if exists ttl_table_ts_column_order;
--enable_warnings
create table ttl_table_ts_column_order(a varchar(1024), b int primary key, c timestamp) TTL(c + INTERVAL 0 SECOND) partition by key(b) partitions 7;
# insert 4*7*500 rows, save one rows per cell

drop procedure if exists insert_data;

delimiter |;
create PROCEDURE insert_data(del int, no_del int)
BEGIN
  DECLARE i INT DEFAULT 0;
	WHILE i < del do
    insert into ttl_table_ts_column_order(a, b, c) values (concat('row', cast(i as char)), i, now());
		set i = i + 1;
	end while;
  while i < del + no_del do
    insert into ttl_table_ts_column_order(a, b, c) values (concat('row', cast(i as char)), i, date_add(now(), interval + 2 MINUTE));
		set i = i + 1;
  end while;
END |
delimiter ;|

call insert_data(500, 100);

sleep 3;
alter system trigger ttl;

--disable_query_log
let $__wait_start_us__ = `select time_to_usec(current_timestamp(6)) from dual`;
let $__wait_timeout_us__ = 180000000;
let $__ttl_done__ = 0;
while($__ttl_done__ == 0)
{
  real_sleep 1;
  let $__wait_used_us__ = `select time_to_usec(current_timestamp(6)) - $__wait_start_us__ from dual`;
  if($__wait_used_us__ > $__wait_timeout_us__)
  {
    let $__ttl_done__ = -1;
  }
  if($__ttl_done__ == 0)
  {
    let $__row_cnt__ = query_get_value(select count(*) as c from ttl_table_ts_column_order, c, 1);
    let $__history_cnt__ = query_get_value(select count(*) as c from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY where table_name = 'ttl_table_ts_column_order' and STATUS = 'FINISHED' and RET_CODE = 'OB_SUCCESS', c, 1);
    let $__global_history_cnt__ = query_get_value(select count(*) as c from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY h where h.table_id = -1 and h.STATUS = 'FINISHED' and h.RET_CODE = 'OB_SUCCESS' and exists (select 1 from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY t where t.table_name = 'ttl_table_ts_column_order' and t.task_id = h.task_id), c, 1);
    if($__row_cnt__ == 100)
    {
      if($__history_cnt__ == 7)
      {
        if($__global_history_cnt__ > 0)
        {
          let $__ttl_done__ = 1;
        }
      }
    }
  }
}
if($__ttl_done__ != 1)
{
  --die ttl_table_ts_column_order ttl task timeout
}
--enable_query_log
select count(*) from ttl_table_ts_column_order;
select TABLE_NAME, TRIGGER_TYPE, STATUS, TTL_DEL_CNT, MAX_VERSION_DEL_CNT, SCAN_CNT, RET_CODE from oceanbase.DBA_OB_KV_TTL_TASK_HISTORY where table_name = 'ttl_table_ts_column_order' order by tablet_id;

drop table ttl_table_ts_column_order;

connection sys;
--disable_query_log
DROP TENANT IF EXISTS tenant_test_ttl FORCE;
DROP RESOURCE POOL IF EXISTS pool_ttl_test;
DROP RESOURCE UNIT IF EXISTS unit_ttl_test;
--enable_query_log
