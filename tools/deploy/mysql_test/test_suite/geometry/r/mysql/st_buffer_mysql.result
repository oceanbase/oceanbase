#
# bugfix: ST_Buffer with extreme coordinates causes SIGFPE crash
# boost::geometry::buffer's rescale policy overflows long long when coordinates
# exceed ~1e9, causing gcd(0, LLONG_MIN) to trigger SIGFPE. Reject such inputs
# with an error instead of crashing.
#
SELECT ST_AsText(ST_Buffer(ST_GeomFromText('LINESTRING(-11546261639905.201 0,1.3202428078720961e-192 -11546412634849.227,-11544872091648.0 0,1.3202428078720961e-192 -11546261639905.227,0 -5.431163892810199e-130)'), 1));
ERROR 22023: Invalid GIS data provided to function.
# coordinates just within the safe limit should still work
SELECT ST_AsText(ST_Buffer(ST_GeomFromText('LINESTRING(0 0, 999999999 0)'), 1)) IS NOT NULL AS within_limit;
within_limit
1
# coordinates just beyond the safe limit should be rejected
SELECT ST_AsText(ST_Buffer(ST_GeomFromText('LINESTRING(0 0, 1000000001 0)'), 1));
ERROR 22023: Invalid GIS data provided to function.
# point with extreme coordinates
SELECT ST_AsText(ST_Buffer(ST_GeomFromText('POINT(1e13 1e13)'), 1));
ERROR 22023: Invalid GIS data provided to function.
# polygon with extreme coordinates
SELECT ST_AsText(ST_Buffer(ST_GeomFromText('POLYGON((0 0, 1e10 0, 1e10 1e10, 0 1e10, 0 0))'), 1));
ERROR 22023: Invalid GIS data provided to function.
